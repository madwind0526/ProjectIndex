{
  "name": "project-index",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5189 --strictPort",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "typecheck": "tsc -b --pretty",
    "check": "node --check server/index.mjs && node --check server/scan.mjs && node --check server/github.mjs && node --check server/store.mjs && node --check server/env.mjs && node --check server/llm.mjs && node --check server/comfy.mjs",
    "test": "npm run check && node --test \"server/*.test.mjs\""
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
